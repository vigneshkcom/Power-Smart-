{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/pipeline.js": { "maxDuration": 60, "memory": 1024, "includeFiles": "{api/_cert-assets/**,node_modules/@sparticuz/chromium/bin/**}" },
    "api/stripe-webhook.js": { "maxDuration": 60, "memory": 1024, "includeFiles": "{api/_cert-assets/**,node_modules/@sparticuz/chromium/bin/**}" }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/quote", "destination": "/api/customer-link?kind=quote" },
    { "source": "/pay", "destination": "/api/customer-link?kind=payment" },
    { "source": "/invoice", "destination": "/api/customer-link?kind=invoice" },
    {
      "source": "/",
      "has": [
        { "type": "host", "value": "portal\\.powersmartco\\.com\\.au" }
      ],
      "destination": "/staff-hub"
    }
  ],
  "redirects": [
    {
      "source": "/staff-hub",
      "has": [
        { "type": "host", "value": "smokealarms\\.powersmartco\\.com\\.au" }
      ],
      "destination": "https://portal.powersmartco.com.au/",
      "permanent": false
    },
    {
      "source": "/tools",
      "has": [
        { "type": "host", "value": "smokealarms\\.powersmartco\\.com\\.au" }
      ],
      "destination": "https://portal.powersmartco.com.au/tools",
      "permanent": false
    },
    {
      "source": "/tools/:path*",
      "has": [
        { "type": "host", "value": "smokealarms\\.powersmartco\\.com\\.au" }
      ],
      "destination": "https://portal.powersmartco.com.au/tools/:path*",
      "permanent": false
    },
    {
      "source": "/tech",
      "has": [
        { "type": "host", "value": "smokealarms\\.powersmartco\\.com\\.au" }
      ],
      "destination": "https://portal.powersmartco.com.au/tech",
      "permanent": false
    },
    {
      "source": "/sms",
      "has": [
        { "type": "host", "value": "smokealarms\\.powersmartco\\.com\\.au" }
      ],
      "destination": "https://portal.powersmartco.com.au/sms",
      "permanent": false
    },
    {
      "source": "/sms/:path*",
      "has": [
        { "type": "host", "value": "smokealarms\\.powersmartco\\.com\\.au" }
      ],
      "destination": "https://portal.powersmartco.com.au/sms/:path*",
      "permanent": false
    },
    { "source": "/sales-portal.html", "destination": "/tools", "permanent": true },
    { "source": "/sales-portal", "destination": "/tools", "permanent": true },
    { "source": "/portal", "destination": "/tools", "permanent": false },
    { "source": "/qld-smoke-alarms.html", "destination": "/", "permanent": true },
    { "source": "/qld-smoke-alarms", "destination": "/", "permanent": true },
    { "source": "/AussieGreenEnergySmokeAlarms.html", "destination": "/archive/AussieGreenEnergySmokeAlarms.html", "permanent": false }
  ]
}
